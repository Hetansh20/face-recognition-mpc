# Dockerfile for the backend/ REST API (used by the Android app and
# admin-web) — distinct from the root Dockerfile, which builds the legacy
# standalone app.py. Build from the repository root:
#
#   docker build -f Dockerfile.backend -t faceattend-backend .
#
FROM python:3.11-slim

# libgl1 + libglib2.0-0 are required by OpenCV (headless still needs them)
# libgomp1 is needed by InsightFace/ONNX for multi-threaded inference
# g++ is needed to compile InsightFace's Cython C++ extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only PyTorch first, to avoid pulling ~2GB of CUDA libraries
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend ./backend
COPY yolov8n-face.pt ./yolov8n-face.pt

# Default data dir if DATA_DIR isn't overridden to a mounted volume —
# registered_faces/, face_database.json, and the embedding cache live here.
RUN mkdir -p registered_faces attendance_reports

EXPOSE 8080

CMD gunicorn backend.app:app \
    --bind 0.0.0.0:${PORT:-8080} \
    --workers 1 \
    --threads 4 \
    --timeout 180 \
    --log-level info
